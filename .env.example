# =============================================================================
# UNIVC Check-in - variaveis de ambiente (ambiente de desenvolvimento local)
# Copie este arquivo para .env antes de rodar `docker compose up`.
# =============================================================================

# --- PostgreSQL (usado pelo servico `db` do docker-compose) -------------------
POSTGRES_USER=univc
POSTGRES_PASSWORD=univc
POSTGRES_DB=univc_checkin
POSTGRES_PORT=5432

# --- API ----------------------------------------------------------------------
# Usada quando voce roda a API, as migrations ou o seed FORA do Docker
# (npm run dev:api, npm run db:migrate). Dentro do docker-compose o container
# monta a propria URL apontando para o servico `db`, ignorando esta linha.
DATABASE_URL=postgresql://univc:univc@localhost:5432/univc_checkin?schema=public

# Banco separado usado pelos testes de integracao (nunca aponte para o banco de dev).
DATABASE_URL_TEST=postgresql://univc:univc@localhost:5432/univc_checkin_test?schema=public

API_PORT=3333
API_HOST=0.0.0.0
NODE_ENV=development

# Segredos JWT. Em producao gere com: openssl rand -hex 32
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso-em-producao-0123456789
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-em-producao-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Origens permitidas no CORS (dashboard web + Expo). Separe por virgula.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# Rate limit do endpoint /checkin
CHECKIN_RATE_LIMIT_MAX=10
CHECKIN_RATE_LIMIT_WINDOW=1 minute

# Fuso horario usado para agrupar registros por dia nos relatorios de jornada.
RELATORIO_TIMEZONE=America/Sao_Paulo

# --- Dashboard (apps/dashboard) ------------------------------------------------
VITE_API_URL=http://localhost:3333

# --- Mobile (apps/mobile) ------------------------------------------------------
# Use o IP da sua maquina na rede local (nao `localhost`) para o Expo Go
# conseguir enxergar a API a partir do celular. Ex.: http://192.168.0.10:3333
EXPO_PUBLIC_API_URL=http://localhost:3333
