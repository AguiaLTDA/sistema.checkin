# =============================================================================
# UNIVC Check-in - variaveis de ambiente (ambiente de desenvolvimento local)
# Copie este arquivo para .env antes de rodar `npm run dev:api` ou
# `docker compose up`.
# =============================================================================

# --- Dados ----------------------------------------------------------------------
# Sem APPS_SCRIPT_URL, o desenvolvimento local grava num arquivo JSON
# (apps/api/.dados/banco.json) e nao precisa de nenhum servico externo.
# Para desenvolver contra uma planilha de TESTE (nunca a de producao),
# preencha as duas variaveis abaixo. Passo a passo no README, secao
# "Banco de dados no Google Sheets".
# ARMAZENAMENTO=arquivo
APPS_SCRIPT_URL=
APPS_SCRIPT_CHAVE=
# A API rele a planilha a cada N segundos para enxergar edicoes feitas a mao.
PLANILHA_CACHE_SEGUNDOS=60

# --- API ----------------------------------------------------------------------
API_PORT=3333
API_HOST=0.0.0.0
NODE_ENV=development

# Segredos JWT. Em producao gere com: openssl rand -hex 32
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso-em-producao-0123456789
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-em-producao-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Origens permitidas no CORS (dashboard, app do professor web + Expo). Separe por virgula.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:19006

# Rate limit do endpoint /checkin
CHECKIN_RATE_LIMIT_MAX=10
CHECKIN_RATE_LIMIT_WINDOW=1 minute

# Fuso horario usado para agrupar registros por dia nos relatorios de jornada.
RELATORIO_TIMEZONE=America/Sao_Paulo

# --- Dashboard (apps/dashboard) ------------------------------------------------
VITE_API_URL=http://localhost:3333

# --- App do professor web (apps/professor-web) ---------------------------------
VITE_API_URL=http://localhost:3333

# --- Mobile (apps/mobile) ------------------------------------------------------
# Use o IP da sua maquina na rede local (nao `localhost`) para o Expo Go
# conseguir enxergar a API a partir do celular. Ex.: http://192.168.0.10:3333
EXPO_PUBLIC_API_URL=http://localhost:3333
