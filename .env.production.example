# =============================================================================
# UNIVC Check-in - variaveis de ambiente de PRODUCAO (VPS)
# Copie para .env.production e preencha antes de rodar o docker-compose.prod.yml.
# =============================================================================

# Connection string do Supabase (Session pooler, porta 5432 - a conexao
# direta db.<ref>.supabase.co e IPv6-only e nao funciona na maioria das
# redes). Senha com caracteres especiais precisa ser URL-encoded.
DATABASE_URL=postgresql://postgres.SEU_REF:SENHA_URLENCODED@aws-0-REGIAO.pooler.supabase.com:5432/postgres?schema=public

# Gere com: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Origem publica do dashboard (sem barra no final).
CORS_ORIGINS=https://checkin.SEU-IP-COM-TRACOS.sslip.io

CHECKIN_RATE_LIMIT_MAX=10
CHECKIN_RATE_LIMIT_WINDOW=1 minute
RELATORIO_TIMEZONE=America/Sao_Paulo

# URL publica da API - entra no build do dashboard (Vite), so tem efeito se
# mudar ANTES de rodar `docker compose ... up -d --build`.
VITE_API_URL=https://api.SEU-IP-COM-TRACOS.sslip.io
